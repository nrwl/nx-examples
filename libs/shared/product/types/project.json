{
  "name": "shared-product-types",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/product/types/src",
  "projectType": "library",
  "generators": {},
  "targets": {
    "codegen": {
      "command": "openapi-ts -i apps/products-api/obj/ProductsApi.json -o {projectRoot}/src/generated -p @hey-api/typescript",
      "dependsOn": ["^build"],
      "inputs": [
        {
          "dependentTasksOutputFiles": "**/obj/ProductsApi.json"
        }
      ],
      "outputs": ["{projectRoot}/src/generated"],
      "cache": true
    }
  },
  "tags": ["type:types", "scope:shared"],
  "implicitDependencies": ["ProductsApi"]
}
